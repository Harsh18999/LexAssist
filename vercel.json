{
    "version": 2,
    "builds": [
        {
            "src": "backend/main.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb"
            }
        }
    ],
    "env": {
        "VERCEL_FORCE_PYTHON_STREAMING": "1"
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/main.py",
            "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]
        },
        {
            "src": "/(.*)",
            "dest": "backend/main.py"
        }
    ]
}